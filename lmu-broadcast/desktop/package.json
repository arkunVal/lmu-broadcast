{
  "name": "flm-broadcast-desktop",
  "version": "1.0.0",
  "description": "FLM Broadcast & Rennleitung fuer Le Mans Ultimate",
  "main": "main.js",
  "private": true,
  "author": "FLM",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "de.flm.broadcast",
    "productName": "FLM Broadcast",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "server.js", "package.json"],
    "extraResources": [
      { "from": "../web/out", "to": "web" },
      { "from": "../reader/dist/FLM-Reader.exe", "to": "reader/FLM-Reader.exe" }
    ],
    "win": { "target": "nsis", "icon": "icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
